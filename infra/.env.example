# Copy to .env and set real values:  cp .env.example .env
# .env is gitignored. Never commit it.

# --- Postgres -----------------------------------------------------------
# 5432 is held by a native postgresql service on this machine, so the
# container is published on 15432 instead. See FM-003.
POSTGRES_PORT=15432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# One password per service database. Services never share credentials.
AUTH_DB_PASSWORD=change-me
EXPENSE_DB_PASSWORD=change-me
INVESTMENT_DB_PASSWORD=change-me
ANALYTICS_DB_PASSWORD=change-me

# --- Redis --------------------------------------------------------------
REDIS_PORT=6379

# --- Kafka --------------------------------------------------------------
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
KAFKA_CLUSTER_ID=fm-local-cluster-0001

# --- Observability (profile: observability) -----------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
